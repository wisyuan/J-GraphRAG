# Lincle M2 environment configuration.
# Copy this file to `.env` and fill in your values, then `source .env` before running.
# `.env` is gitignored — never commit real secrets.

# --- Embedding (bge-m3) ---
# HuggingFace model id (default) or a local path to downloaded weights.
LINCLE_BGE_M3_MODEL=BAAI/bge-m3
LINCLE_BGE_M3_PATH=BAAI/bge-m3
# Device: leave empty for auto, or set to cuda / mps / cpu.
LINCLE_BGE_M3_DEVICE=

# --- LLM (DeepSeek, OpenAI-compatible) ---
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Datasets ---
# Path to a clone of earendil-works/pi (for bet #1a code domain).
LINCLE_PI_REPO=
# Path to a public-domain novel .txt (for bet #1b novel domain).
LINCLE_NOVEL_PATH=
