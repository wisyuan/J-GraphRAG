# J-GraphRAG environment configuration (default providers only).
# Copy to `.env` and adjust, then `source .env` before running.
# `.env` is gitignored — never commit real secrets.
# Custom providers/stores are injected in code and need none of these.

# --- Default EmbedProvider (bge-m3) ---
# HuggingFace model id (default) or a local path to downloaded weights.
LINCLE_BGE_M3_MODEL=BAAI/bge-m3
LINCLE_BGE_M3_PATH=BAAI/bge-m3
# Device: cpu (default, safe alongside the 4bit LLM on 8GB GPUs) / cuda / mps.
# NOTE: the on-disk embedding cache is namespaced by device — switching this
# triggers a full re-embed.
LINCLE_BGE_M3_DEVICE=cpu

# --- Default LensProvider (Qwen2.5-7B-Instruct 4bit + Jacobian Lens) ---
# Local weights dir (restore_env.sh links it to /tmp); falls back to the HF id
# when the dir is absent/incomplete.
JGRAPHRAG_QWEN_MODEL_PATH=/tmp/qwen25-7b-it-weights
JGRAPHRAG_QWEN_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Local jlens lens dir; falls back to HF neuronpedia/jacobian-lens when absent.
JGRAPHRAG_JLENS_LENS_PATH=/tmp/jlens-qwen25-7b-it

# --- Embedding disk cache ---
# JGRAPHRAG_EMBED_CACHE_DIR=data/.embedcache
